# Local configuration only. No seeded users, credentials, or events.
PORT=3001
# Default is LoginLab/data/portal.sqlite, relative paths resolve from the inner project.
# DATABASE_PATH=./data/portal.sqlite
# Optional exact origins, comma-separated. Leave unset to use each workflow's local origin.
# TRUSTED_ORIGINS=http://127.0.0.1:5173
# Explicit known reverse proxy IPs only. Empty means ignore forwarded headers.
TRUSTED_PROXY_IPS=
# Initial limit on first initialization. Later updates are admin-only and persisted.
AUDIT_RETENTION_LIMIT=2000
