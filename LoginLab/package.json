{
  "name": "digital-vault",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && node scripts/clean-server.mjs && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env --import ./scripts/production-env.mjs dist-server/index.js",
    "test": "tsx --test server/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "format": "prettier --write src server scripts vite.config.js",
    "db:init": "node --env-file-if-exists=.env --import tsx server/admin.ts --init",
    "admin:setup": "node --env-file-if-exists=.env --import tsx server/admin.ts",
    "cloud:admin": "node --env-file-if-exists=.env --import tsx server/cloud-admin.ts",
    "cloud:import-admin": "node --env-file-if-exists=.env --import tsx server/cloud-import-admin.ts"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "netlify-cli": "^27.10.2",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
